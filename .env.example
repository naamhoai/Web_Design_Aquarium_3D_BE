# Sao chép file này thành .env rồi điền giá trị. File .env đã được .gitignore bỏ qua — KHÔNG commit giá trị thật.
# start_dev.bat tự nạp file .env này cho mọi service.
# Ghi dạng TEN=gia_tri, KHÔNG đặt giá trị trong dấu ngoặc kép (start_dev.bat đọc nguyên văn cả dấu ").

# ---- PostgreSQL (bắt buộc) ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aquarium_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# ---- JWT (bắt buộc) ----
# Chuỗi ngẫu nhiên >= 32 ký tự, DÙNG CHUNG cho mọi service. Ví dụ tạo bằng:
#   PowerShell:  $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
#   Git Bash:    openssl rand -base64 48
# Để trống => start_dev.bat sinh khóa tạm cho mỗi lần khởi động (phải đăng nhập lại sau khi restart).
JWT_SECRET=

# ---- Bảo mật khác ----
# Cookie refresh chỉ gửi qua HTTPS. Chrome/Edge/Firefox vẫn chấp nhận trên http://localhost; đặt false nếu dùng Safari khi dev.
AUTH_COOKIE_SECURE=true
# Origin của frontend được phép gọi API (phân tách bằng dấu phẩy, không dùng *)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Swagger UI trên từng service — chỉ nên bật khi dev
SWAGGER_ENABLED=true
# Giới hạn tần suất tại API Gateway (request / phút / IP)
RATE_LIMIT_DEFAULT=300
RATE_LIMIT_AUTH=20

# ---- docker-compose (hạ tầng tùy chọn: Postgres container, Redis, Kafka, MinIO) ----
POSTGRES_DOCKER_PORT=5433
REDIS_PASSWORD=
MINIO_ROOT_USER=aquarium-admin
MINIO_ROOT_PASSWORD=
